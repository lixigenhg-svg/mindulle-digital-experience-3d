# 纯静态单人模式
VITE_WS_URL=off

# 多人模式示例
# VITE_WS_URL=ws://localhost:8080
# VITE_WS_URL=wss://your-domain.com/ws

# Optional rain tea sales API. GET /access returns available, entitled, priceWon.
# POST /checkout returns checkoutUrl. The backend owns the price and verifies
# payment before granting account-bound, reusable access. Both use credentials.
# VITE_RAIN_TEA_API=https://example.com/rain-tea
# Rain tea invitations: authenticated buyer POST /rooms returns { invite }.
# POST /rooms/:invite/join admits at most one guest with a valid invite, without a purchase.
# POST /rooms/:invite/presence refreshes an authorized participant's short lease and
# returns { companionPresent }. The server must validate the host's entitlement,
# expire guest access and invitations with the session, and bind both roles to sessions.
