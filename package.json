{
  "name": "mindulle-digital-experience-3d",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/dev-server.ts",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/postprocessing": "2.19.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.62.0",
    "@types/react": "18.3.30",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.160.0",
    "@types/ws": "8.5.12",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "concurrently": "9.0.1",
    "jsdom": "^26.1.0",
    "php-parser": "^3.7.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.1",
    "typescript": "5.5.4",
    "vite": "5.4.8",
    "vitest": "^3.2.4"
  }
