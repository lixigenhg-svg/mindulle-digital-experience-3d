{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "seo/korean-crawlability": false
    }
  },
  "headers": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "room",
          "value": "pri-.*"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
